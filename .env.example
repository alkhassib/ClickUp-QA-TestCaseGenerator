# ============ ClickUp ============
# Settings > Apps > Generate API Token
CLICKUP_API_TOKEN=pk_xxxxxxxx_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Workspace ID - get it from GET /api/v2/team or from the ClickUp URL
CLICKUP_TEAM_ID=0000000000000000

# The list holding the user stories, and the status that triggers the flow
SOURCE_LIST_ID=000000000000000
INPUT_COLUMN=user story

# Where the new test-case tasks are created
# Same value as SOURCE_LIST_ID => "same list, different status"
# A different List ID     => "a fully separate list"
OUTPUT_LIST_ID=000000000000000
OUTPUT_COLUMN=Generated

# The status the original user story moves to once it has been processed
# (so it is not picked up again on the next polling cycle)
STORY_DONE_COLUMN=Test Cases Generated

# ============ OpenAI ============
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5-nano

# Test-case generation language: ar (Arabic) or en (English). Default: ar
TEST_CASE_LANGUAGE=ar

# ============ Runtime ============
# How often (in minutes) the script polls for new tasks
POLL_INTERVAL_MINUTES=10

# Max tasks processed per polling cycle (cost guard when many tasks pile up)
MAX_TASKS_PER_RUN=20

# Number of retry attempts when a ClickUp API call fails
MAX_RETRIES=3

# true = run everything without actually writing to ClickUp (for the first trial)
DRY_RUN=true

LOG_FILE_PATH=automation.log
